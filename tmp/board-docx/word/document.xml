/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh wp14"><w:body><w:p w14:paraId="567137E9" w14:textId="77777777" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="005326E5"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Mr. Thomas Fernando</w:t></w:r></w:p><w:p w14:paraId="507AD224" w14:textId="77777777" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:r w:rsidRPr="005326E5"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Director / Board Chairman</w:t></w:r></w:p><w:p w14:paraId="12DC8985" w14:textId="3A43E012" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="00F27C84"><w:pPr><w:jc w:val="both"/></w:pPr><w:r w:rsidRPr="005326E5"><w:t>Mr. Thomas Fernando serves as the Chairman of Ceylon Development Funding Force Pvt Ltd (CDFF), bringing over 25 years of distinguished experience in Sri Lanka’s financial services sector. With a Diploma in Marketing from the University of Colombo, he has built a strong career centered on strategic expansion, institutional strengthening and sustainable financial leadership.</w:t></w:r></w:p><w:p w14:paraId="31947002" w14:textId="367F8197" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="00F27C84"><w:pPr><w:jc w:val="both"/></w:pPr><w:r w:rsidRPr="005326E5"><w:t>As Chairman, Mr. Fernando provides strategic oversight and governance leadership, ensuring that CDFF operates with integrity, discipline and long-term vision. His guidance reinforces the organization’s commitment to responsible lending, ethical standards and structured growth aligned with national economic development priorities.</w:t></w:r></w:p><w:p w14:paraId="2699DB83" w14:textId="77777777" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="00F27C84"><w:pPr><w:jc w:val="both"/></w:pPr><w:r w:rsidRPr="005326E5"><w:t>Under his stewardship, CDFF continues to strengthen its governance framework while expanding its footprint across Sri Lanka.</w:t></w:r></w:p><w:p w14:paraId="778701CF" w14:textId="77777777" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:r w:rsidRPr="005326E5"><w:pict w14:anchorId="66E26845"><v:rect id="_x0000_i1049" style="width:0;height:1.5pt" o:hralign="center" o:hrstd="t" o:hr="t" fillcolor="#a0a0a0" stroked="f"/></w:pict></w:r></w:p><w:p w14:paraId="115D5E82" w14:textId="77777777" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="005326E5"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Mr. Mahesh Perera</w:t></w:r></w:p><w:p w14:paraId="45FF61E4" w14:textId="77777777" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:r w:rsidRPr="005326E5"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Director / Chief Executive Officer</w:t></w:r></w:p><w:p w14:paraId="715B384C" w14:textId="549B421D" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="00F27C84"><w:pPr><w:jc w:val="both"/></w:pPr><w:r w:rsidRPr="005326E5"><w:t>Mr. Mahesh Perera is the Chief Executive Officer of CDFF and a seasoned financial services leader with over 20 years of industry experience. His career includes senior leadership roles at Ceylinco Grameen (HNB Finance) and Commercial Credit PLC, where he gained extensive expertise in portfolio management, credit governance and branch network expansion.</w:t></w:r></w:p><w:p w14:paraId="538BBEF5" w14:textId="77777777" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="00F27C84"><w:pPr><w:jc w:val="both"/></w:pPr><w:r w:rsidRPr="005326E5"><w:t>He holds a Master of Business Administration (MBA) from Cardiff Staffordshire University (UK) and is recognized for his strategic clarity and operational discipline.</w:t></w:r></w:p><w:p w14:paraId="3329A6E1" w14:textId="63443E94" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="00F27C84"><w:pPr><w:jc w:val="both"/></w:pPr><w:r w:rsidRPr="005326E5"><w:t>As CEO, Mr. Perera is responsible for shaping the company’s strategic direction, strengthening risk management frameworks, enhancing operational efficiency and fostering stakeholder confidence. His leadership continues to position CDFF as a stable and growth-oriented financial institution committed to inclusive economic progress.</w:t></w:r></w:p><w:p w14:paraId="5FF3D277" w14:textId="77777777" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:r w:rsidRPr="005326E5"><w:pict w14:anchorId="16C71C46"><v:rect id="_x0000_i1050" style="width:0;height:1.5pt" o:hralign="center" o:hrstd="t" o:hr="t" fillcolor="#a0a0a0" stroked="f"/></w:pict></w:r></w:p><w:p w14:paraId="6523BD69" w14:textId="77777777" w:rsidR="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="035EE34C" w14:textId="77777777" w:rsidR="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="16FB4C09" w14:textId="77777777" w:rsidR="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="4394C7AE" w14:textId="77777777" w:rsidR="00F27C84" w:rsidRDefault="00F27C84" w:rsidP="005326E5"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="27DDF912" w14:textId="4C21B11F" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="005326E5"><w:rPr><w:b/><w:bCs/></w:rPr><w:lastRenderedPageBreak/><w:t>Mr. Ivan Bandara</w:t></w:r></w:p><w:p w14:paraId="09A8F937" w14:textId="77777777" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:r w:rsidRPr="005326E5"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Director / Deputy Chief Executive Officer</w:t></w:r></w:p><w:p w14:paraId="326D6602" w14:textId="3DBD3ABF" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="00F27C84"><w:pPr><w:jc w:val="both"/></w:pPr><w:r w:rsidRPr="005326E5"><w:t>Mr. Ivan Bandara brings over two decades of experience in microfinance and financial services operations. His professional background includes leadership roles at Ceylinco Grameen (HNB Finance), Commercial Credit PLC and LOLC, where he played key roles in operational scaling and performance optimization.</w:t></w:r></w:p><w:p w14:paraId="29EF28F4" w14:textId="1F8397BE" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="00F27C84"><w:pPr><w:jc w:val="both"/></w:pPr><w:r w:rsidRPr="005326E5"><w:t>He holds an MBA from Preah Sihamoniraja Buddhist University (Cambodia) and possesses strong expertise in branch performance management, operational strategy execution and credit discipline.</w:t></w:r></w:p><w:p w14:paraId="5702E464" w14:textId="16610C26" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="00F27C84"><w:pPr><w:jc w:val="both"/></w:pPr><w:r w:rsidRPr="005326E5"><w:t>As Deputy CEO, Mr. Bandara focuses on enhancing branch productivity, strengthening portfolio quality and aligning field operations with corporate strategy. His operational leadership ensures consistent service standards and sustainable institutional growth across CDFF’s branch network.</w:t></w:r></w:p><w:p w14:paraId="2500C2AC" w14:textId="77777777" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:r w:rsidRPr="005326E5"><w:pict w14:anchorId="6F9470E9"><v:rect id="_x0000_i1051" style="width:0;height:1.5pt" o:hralign="center" o:hrstd="t" o:hr="t" fillcolor="#a0a0a0" stroked="f"/></w:pict></w:r></w:p><w:p w14:paraId="2938FB01" w14:textId="77777777" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="005326E5"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Mr. P. Kovarthan</w:t></w:r></w:p><w:p w14:paraId="0A0229E3" w14:textId="77777777" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:r w:rsidRPr="005326E5"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Director / Chief Operations Officer</w:t></w:r></w:p><w:p w14:paraId="100D98BF" w14:textId="241BC328" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:r w:rsidRPr="005326E5"><w:t>Mr. P. Kovarthan has over 20 years of experience in microfinance operations and institutional management. His career spans leadership roles at Ceylinco Grameen, Commercial Credit PLC and Nation Lanka Finance PLC, where he developed deep expertise in operational structuring, portfolio monitoring, and process optimization.</w:t></w:r></w:p><w:p w14:paraId="74A9A276" w14:textId="77777777" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:r w:rsidRPr="005326E5"><w:t>Holding a Bachelor of Business Administration (BBA) in Management, Mr. Kovarthan is known for his disciplined approach to operational excellence and credit quality assurance.</w:t></w:r></w:p><w:p w14:paraId="2ACA8939" w14:textId="581A9598" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:r w:rsidRPr="005326E5"><w:t>As Chief Operations Officer, he oversees day-to-day operational functions, ensures adherence to credit standards and drives service efficiency across CDFF’s branch network. His structured operational leadership supports sustainable portfolio growth and institutional stability.</w:t></w:r></w:p><w:p w14:paraId="36FF0907" w14:textId="77777777" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:r w:rsidRPr="005326E5"><w:pict w14:anchorId="2CBC7F6D"><v:rect id="_x0000_i1052" style="width:0;height:1.5pt" o:hralign="center" o:hrstd="t" o:hr="t" fillcolor="#a0a0a0" stroked="f"/></w:pict></w:r></w:p><w:p w14:paraId="4F33ADFE" w14:textId="77777777" w:rsidR="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="75D712D9" w14:textId="77777777" w:rsidR="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="78DB79AC" w14:textId="77777777" w:rsidR="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="6A14E59D" w14:textId="77777777" w:rsidR="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="710A29A8" w14:textId="16D7A656" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="005326E5"><w:rPr><w:b/><w:bCs/></w:rPr><w:lastRenderedPageBreak/><w:t>Mr. Jagath Ranathunga</w:t></w:r></w:p><w:p w14:paraId="2DED0340" w14:textId="77777777" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:r w:rsidRPr="005326E5"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Consultant</w:t></w:r></w:p><w:p w14:paraId="78A27368" w14:textId="0EE9CDAD" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:r w:rsidRPr="005326E5"><w:t>Mr. Jagath Ranathunga is a respected entrepreneur with extensive experience in real estate development and corporate administration. His expertise in asset management, infrastructure development and institutional administration adds strategic value to CDFF’s governance and operational framework.</w:t></w:r></w:p><w:p w14:paraId="0B324FBA" w14:textId="3A841714" w:rsidR="005326E5" w:rsidRPr="005326E5" w:rsidRDefault="005326E5" w:rsidP="005326E5"><w:r w:rsidRPr="005326E5"><w:t>In his advisory capacity, Mr. Ranathunga supports administrative oversight, infrastructure planning and organizational strengthening initiatives. His insights contribute to maintaining operational stability and long-term institutional discipline within CDFF.</w:t></w:r></w:p><w:p w14:paraId="1F983B43" w14:textId="77777777" w:rsidR="005326E5" w:rsidRDefault="005326E5"/><w:sectPr w:rsidR="005326E5"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="720" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>